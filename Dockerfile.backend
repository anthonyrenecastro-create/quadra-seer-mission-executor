# Production image for the Node/Express API (server.js, port 3001).
# Includes python3 because the HRM adapter shells out to `python3` with the
# repo's local hrm/ package (cwd = repo root). Without python3 the bridge
# degrades gracefully to { available: false }, but we ship it working.
FROM node:22.21.1-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package-lock.json package.json ./
RUN npm ci --omit=dev

COPY . .

# Non-root runtime user. COLLAB_DATA_DIR is expected to be a mounted volume.
RUN useradd -m -u 10001 appuser && \
    mkdir -p /data/collab-data && \
    chown -R appuser:appuser /app /data/collab-data
USER appuser

ENV NODE_ENV=production \
    PORT=3001 \
    COLLAB_DATA_DIR=/data/collab-data

EXPOSE 3001

HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
