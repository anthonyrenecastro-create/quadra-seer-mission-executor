# =========================
# Core backend configuration
# =========================

# Gemini key used by Atlantean backend for LLM generation.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Flask session security.
ATLANTEAN_SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
SESSION_COOKIE_SECURE=0

# Comma-separated CORS allowlist for backend APIs.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Redis host for primary low-latency persistence.
REDIS_HOST=localhost

# =========================
# Collaboration layer auth (fail-closed: token mode unless explicitly disabled)
# =========================

# Auth mode: 'token' (default, required for anything internet-facing) or
# 'disabled' (explicit opt-in ONLY for trusted local development — world-writable API).
COLLAB_AUTH=token

# Single shared API token (simplest token-mode setup; maps to actor id 'token-owner').
# For multiple users, use COLLAB_ACTORS instead.
COLLAB_API_TOKEN=<redacted>

# JSON map of bearer tokens to actors, e.g.:
# {"tok-alice": {"id": "alice", "name": "Alice"}, "tok-bob": {"id": "bob", "name": "Bob"}}
COLLAB_ACTORS={}

# Port the Express API listens on (also honored via the PORT env var).
PORT=3001

# Directory for the collaboration JSON store (should be a persistent volume in production).
COLLAB_DATA_DIR=./collab-data
